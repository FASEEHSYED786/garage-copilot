# Copy to .env and fill in only what you want to switch on. Never commit .env.

# offline (default) | openai | anthropic
GARAGE_LLM_PROVIDER=offline
# GARAGE_LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Set to require an X-API-Key header on every API request
# GARAGE_API_KEY=

# mock (default) | dvsa
GARAGE_VEHICLE_SOURCE=mock
# DVSA_API_KEY=
# DVSA_ACCESS_TOKEN=
